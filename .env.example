# Replace BOTH placeholders before starting the API. Never commit real secrets.
PYC_WALLET_MASTER_KEY=CHANGE_ME
PYC_JWT_SECRET=CHANGE_ME
PYC_APP_DB=data/app.sqlite3
PYC_NODE_DB=data/node-a.sqlite3
PYC_NODE_HOST=127.0.0.1
PYC_NODE_PORT=5001
PYC_API_HOST=127.0.0.1
PYC_API_PORT=8000
PYC_FRONTEND_ORIGIN=http://localhost:5173
PYC_DEMO_MODE=true
# Enable when serving the application over HTTPS; required outside demo mode.
PYC_COOKIE_SECURE=false
PYC_ENABLE_ADMIN_ROUTES=false
